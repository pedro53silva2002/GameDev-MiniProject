[sub_resource type="GDScript" id="GDScript_md0e3"]
script/source = "extends CharacterBody2D
class_name ENEMY

const Player = preload(\"res://player/player.tscn\")
const SPEED = 100.0
const JUMP_VELOCITY = -400.0
var direction =-1
@onready var ray_cast_right: RayCast2D = $RayCastRight
@onready var ray_cast_left: RayCast2D = $RayCastLeft

func _physics_process(delta: float) -> void:
	if ray_cast_right.is_colliding():
		var collider = ray_cast_right.get_collider()
		#print(collider.name)
		if collider and collider.name != \"Player\":  # ignore Player
			direction = -1
	if ray_cast_left.is_colliding():
		var collider = ray_cast_left.get_collider()
		#print(collider.name)
		if collider and collider.name != \"Player\":  # ignore Player
			direction = 1

	position.x += direction * SPEED * delta
	position.y = 94.0

	move_and_slide()


func _on_area_2d_body_entered(body: Node2D) -> void:
	#print(body)
	if body.name == \"Player\":
		#print(\"Its Player\")
		body.velocity.x = direction * 250 #adjust this force to your liking
		body.velocity.y = -500# optional: knock the player upward a bitd
"

